---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBar from '../components/SkillBar.astro';
import { profile } from '../data/profile';
import { skillCategories } from '../data/skills';
import { experience, education } from '../data/experience';
---

<BaseLayout title="E-Resume" active="resume" description={`Interactive resume of ${profile.name} — Software Engineer in Dubai.`}>
  <!-- Print-only header (invisible on screen, appears only in the printed PDF) -->
  <div class="print-header">
    <h1>{profile.name}</h1>
    <div class="print-contact">
      {profile.email} · {profile.phone} · {profile.location} · {profile.languages.join(' / ')}
    </div>
  </div>

  <section style="padding-top: 3rem;">
    <div class="container">
      <span class="section-label">E-Resume</span>
      <h2 class="section-title">Interactive Resume</h2>
      <p class="section-sub">
        The same content as my resume, but with the parts a PDF can't show —
        animated skill bars, expandable experience, and a clean print layout.
      </p>

      <div class="resume-actions">
        <button class="btn btn-primary" id="print-btn" type="button">⬇ Save as PDF</button>
        <a class="btn btn-ghost" href={profile.resumePdf} download>Download resume.pdf</a>
        <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Email me</a>
      </div>

      <!-- Summary -->
      <div class="resume-block">
        <span class="section-label">Profile</span>
        <h2 class="section-title" style="font-size: 1.5rem;">Summary</h2>
        <p style="max-width: 72ch; color: var(--text-dim);">{profile.summary}</p>
      </div>

      <!-- Skills -->
      <div class="resume-block" style="margin-top: 3rem;">
        <span class="section-label">Skills</span>
        <h2 class="section-title" style="font-size: 1.5rem;">Technical Skills</h2>
        <SkillBar categories={skillCategories} />
      </div>

      <!-- Experience -->
      <div class="resume-block" style="margin-top: 3rem;">
        <span class="section-label">Experience</span>
        <h2 class="section-title" style="font-size: 1.5rem;">Work Experience</h2>
        <div id="exp-accordion" class="exp-accordion">
          {
            experience.map((entry) => (
              <details class="exp-details" open={entry.current}>
                <summary class="exp-summary">
                  <span class="exp-role">
                    <strong>{entry.role}</strong> @ {entry.company}
                  </span>
                  <span class="tl-period">{entry.period}</span>
                </summary>
                <p class="tl-summary">{entry.summary}</p>
                <ul class="tl-bullets">
                  {entry.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </details>
            ))
          }
        </div>
      </div>

      <!-- Education -->
      <div class="resume-block" style="margin-top: 3rem;">
        <span class="section-label">Education</span>
        <h2 class="section-title" style="font-size: 1.5rem;">Education</h2>
        {
          education.map((e) => (
            <div class="tl-entry" style="margin-left: 0.6rem; padding-left: 1.4rem;">
              <h3 style="font-size: 1.05rem;">{e.degree}</h3>
              <div style="color: var(--accent); font-weight: 600;">{e.school}</div>
              <div class="tl-period">{e.location} · {e.period}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .exp-accordion {
    display: grid;
    gap: 1rem;
    max-width: 820px;
  }
  .exp-details {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0 1.5rem;
  }
  .exp-summary {
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1.1rem 0;
    list-style: none;
  }
  .exp-summary::-webkit-details-marker {
    display: none;
  }
  .exp-summary::before {
    content: '▸';
    color: var(--accent);
    margin-right: 0.7rem;
    transition: transform 0.15s;
  }
  .exp-details[open] .exp-summary::before {
    transform: rotate(90deg);
  }
  .exp-details .tl-summary,
  .exp-details .tl-bullets {
    padding-bottom: 1.1rem;
  }
  .print-header {
    display: none;
  }

  /* ---------- print stylesheet: clean A4 resume from the same page ---------- */
  @media print {
    body {
      background: #fff;
      color: #000;
      font-size: 11pt;
    }
    .nav,
    .footer,
    .resume-actions,
    .section-label,
    .section-title,
    .section-sub {
      display: none !important;
    }
    .skill-fill {
      width: var(--fill) !important; /* force bars full width in print */
    }
    .exp-details {
      border: none;
      padding: 0;
      background: none;
    }
    .exp-summary {
      padding: 0.4rem 0;
    }
    .exp-details .tl-summary,
    .exp-details .tl-bullets {
      padding-bottom: 0.6rem;
    }
    .skill-card {
      border: none;
      padding: 0.4rem 0;
      break-inside: avoid;
    }
    .skill-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem 2rem;
    }
    .timeline,
    .tl-entry {
      break-inside: avoid;
    }
    .print-header {
      display: block;
      margin-bottom: 1.2rem;
      border-bottom: 2px solid #000;
      padding-bottom: 0.8rem;
    }
    .print-header h1 {
      font-size: 22pt;
      margin: 0 0 0.3rem;
    }
    .print-contact {
      font-size: 9.5pt;
      color: #333;
    }
    section {
      padding: 0 !important;
    }
    .resume-block {
      margin-top: 0.8rem !important;
    }
    a {
      color: #000;
      text-decoration: none;
    }
  }
</style>

<script>
  // "Save as PDF" → opens the browser print dialog with the print stylesheet
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>
