---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags } = post.data;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <section style="padding-top: 3.5rem;">
    <div class="container">
      <div style="max-width: 72ch;">
        <a href={url('/blog/')} style="font-size: 0.9rem;">← All posts</a>
        <span class="section-label" style="margin-top: 1.2rem;">
          {fmt.format(pubDate)}
        </span>
        <h1 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 0.5rem;">{title}</h1>
        {
          tags.length > 0 && (
            <div class="tags" style="margin-bottom: 2rem;">
              {tags.map((t) => <span class="tag plain">#{t}</span>)}
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
